# Supabase (Project Settings → API keys). The publishable key ships to browsers; the secret key never does.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Dodo Payments: test key on Preview/local, live key on Production
# (live mode is automatic on the production deployment, see src/server/env.ts)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# protects /api/cron/chat-digest (same value in the Supabase Vault as cron_secret: supabase/migrations/20261114000000_setup.sql)
CRON_SECRET=

# Resend: every app email (src/server/email/templates.ts). Without it nothing is emailed; the rest still works.
RESEND_API_KEY=

# Live city room server (realtime/, Cloudflare). Unset = no live positions; the game works as before.
# local: npm run rt:dev → http://localhost:8787 · host: production → prod worker, previews → staging
NEXT_PUBLIC_REALTIME_URL=

# --- Set by the host, not by you (read in src/config/deployEnv.ts; listed so nothing is a surprise) ---
# Netlify: NETLIFY, CONTEXT, URL, DEPLOY_PRIME_URL · Vercel: VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL
# Baked in at build time by next.config.ts from the above: DEPLOY_ENV, DEPLOY_ORIGIN

# --- Room server (realtime/): lives in realtime/wrangler.toml [vars] and Cloudflare secrets, NOT in this file ---
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, ALLOWED_ORIGINS, ENV_NAME  → wrangler.toml per environment
# LOADTEST_SECRET → staging only: `wrangler secret put LOADTEST_SECRET --env staging` (production refuses to start with it)

# --- GitHub Actions (.github/workflows/realtime.yml): repo Secrets / Variables, NOT in this file ---
# secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, LOADTEST_SECRET · variables: STAGING_REALTIME_URL
